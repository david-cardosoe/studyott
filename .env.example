# Copy to .env.local and fill in. Never commit .env.local.
# Local values come from `pnpm db:start` (it prints the URL and keys).

# Supabase (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key. SERVER ONLY: used only by account deletion.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Local test login (seed users test1@studyott.local and test2@studyott.local).
# LOCAL ONLY: must match supabase/seed.sql. Safe to commit.
TEST_USER_PASSWORD=studyott-local-pw

# Google OAuth client (read by supabase/config.toml for local auth; Phase 2)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
